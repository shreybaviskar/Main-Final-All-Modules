<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Separate list view for service.combo.tracker (for One2many context) -->
    <record id="view_combo_tracker_tree_for_master" model="ir.ui.view">
        <field name="name">service.combo.tracker.list.for.master</field>
        <field name="model">service.combo.tracker</field>
        <field name="arch" type="xml">
            <list string="Service Combo Tracker" delete="0" create="0" edit="0">
                <field name="service_combo_id" string="Service Combo"/>
                <field name="service_id" string="Service"/>
                <field name="state"/>
                <field name="completed_date"/>
                <field name="description"/>
                <field name="expiry_date"/>
                <field name="is_infinite"/>
            </list>
        </field>
    </record>

    <!-- Master form view -->
    <record id="view_combo_service_master_form" model="ir.ui.view">
        <field name="name">service.combo.master.form</field>
        <field name="model">service.combo.master</field>
        <field name="arch" type="xml">
            <form create="0">

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle" options="{'no_create': True}"/>
                            <field name="brand" readonly="1"/>
                            <field name="model" readonly="1"/>
                        </group>
                        <group>
                            <field name="tracker_count" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Service Combo">
                            <field name="jobcard_line_id"
                                   widget="one2many"
                                   mode="list"
                                   context="{'list_view_ref': 'aos_servicecombo_aretx.view_combo_tracker_tree_for_master'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view for master -->
    <record id="view_combo_service_master_tree" model="ir.ui.view">
        <field name="name">service.combo.master.list</field>
        <field name="model">service.combo.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="tracker_count"/>
            </list>
        </field>
    </record>

    <!-- Server Action to open form properly -->
    <record id="action_open_subscription" model="ir.actions.server">
        <field name="name">Open Subscription</field>
        <field name="model_id" ref="model_service_combo_master"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_subscription_form()
        </field>
    </record>

    <!-- Regular window action for tree/form views -->
    <record id="action_combo_master" model="ir.actions.act_window">
        <field name="name">Subscription</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">service.combo.master</field>
        <field name="view_mode">form</field>

        <field name="context">{}</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Subscription
            </p>
            <p>
                Select a vehicle to view its service combo subscriptions.
            </p>
        </field>
    </record>

    <!-- Menu using server action -->
    <menuitem id="menu_service_master"
              name="Subscription"
              action="action_open_subscription"
              sequence="-1"/>
</odoo>