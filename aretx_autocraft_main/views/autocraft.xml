<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_crm_lead_form_inherit_mobile_final" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.mobile</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">


            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Booking Date</attribute>
            </xpath>

        </field>
    </record>

    <record id="crm_lead_tree_opportunity_booking_date" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity.booking.date</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>

        <field name="arch" type="xml">

            <!-- Change label of the visible date_deadline field -->
            <xpath expr="//list/field[@name='date_deadline' and @optional='hide']"
                   position="attributes">
                <attribute name="string">Booking Date</attribute>
            </xpath>

        </field>
    </record>

    <record id="sale_order_form_inherit_service_fields" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.service.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">


            <xpath expr="//field[@name='validity_date']"
                   position="before">

                <field name="entry_date"/>
                <field name="exit_date"/>


            </xpath>

        </field>
    </record>

    <record id="sale_quotation_tree_add_entry_exit_date" model="ir.ui.view">
        <field name="name">sale.quotation.tree.add.entry.exit.date</field>
        <field name="model">sale.order</field>

        <!-- External ID -->
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="entry_date" optional="hide"/>
                <field name="exit_date" optional="hide"/>
            </xpath>

        </field>
    </record>


    <!-- HHHHHHHHHHHHHH -->

</odoo>