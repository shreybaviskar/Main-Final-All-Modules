<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_srno" inherit_id="account.report_invoice_document">

        <!-- Make entire invoice font 15% smaller -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <style>
                .page { font-size: 85% !important; }
            </style>
        </xpath>

        <!-- Add Sr. header before Description -->
        <xpath expr="//table[@name='invoice_line_table']/thead//th[@name='th_description']" position="before">
            <th class="text-center" style="width: 40px;">Sr.</th>
        </xpath>

        <!-- Initialize sr_no counter before the loop -->
        <xpath expr="//table[@name='invoice_line_table']/tbody//t[@t-set='lines']" position="after">
            <t t-set="sr_no" t-value="0"/>
        </xpath>

        <!-- Add Sr. No cell before Description cell in product lines -->
        <xpath expr="//table[@name='invoice_line_table']/tbody//td[@name='account_invoice_line_name']" position="before">
            <t t-set="sr_no" t-value="sr_no + 1"/>
            <td class="text-center"><span t-out="sr_no"/></td>
        </xpath>

    </template>
</odoo>