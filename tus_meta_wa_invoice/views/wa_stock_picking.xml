<?xml version="1.0" ?>
<odoo>
    <record id="view_picking_form_inherit_wa_delivery" model="ir.ui.view">
        <field name="name">stock.picking.form.wa.delivery.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button
                    name="%(tus_meta_whatsapp_base.action_wa_compose_message_wizard)d"
                    type="action"
                    string="Send Delivery Order by WhatsApp"
                    context="{'report': 'stock.report_deliveryslip'}"
                    invisible="state in ('draft', 'cancel')"
                    groups="tus_meta_whatsapp_base.whatsapp_group_invoice_user"
                />
            </xpath>
        </field>
    </record>
</odoo>