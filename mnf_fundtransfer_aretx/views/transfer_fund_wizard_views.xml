<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transfer_funds_wizard_form" model="ir.ui.view">
        <field name="name">transfer.funds.wizard.form</field>
        <field name="model">driver.transfer.funds.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Funds">
                <group>
                    <field name="source_journal_id"/>
                    <field name="destination_journal_id"/>
                    <field name="amount"/>
                    <!-- currency_id is auto-computed from the source journal; kept hidden -->
                    <field name="currency_id" invisible="1"/>
                    <field name="date"/>
                    <field name="note" placeholder="Add an optional memo here…"/>
                </group>
                <footer>
                    <button name="action_confirm_transfer"
                            type="object"
                            string="Transfer"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>