<odoo>

    <!-- LIST VIEW -->
    <record id="view_dynamic_product_cut_list" model="ir.ui.view">
        <field name="name">dynamic.product.cut.list</field>
        <field name="model">dynamic.product.cut</field>
        <field name="arch" type="xml">
            <list>
                <field name="wood_template_id"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_dynamic_product_cut_form" model="ir.ui.view">
        <field name="name">dynamic.product.cut.form</field>
        <field name="model">dynamic.product.cut</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process_cut"
                            type="object"
                            string="Process"
                            class="btn-primary"/>
                </header>

                <group>
                    <field name="wood_template_id"/>
                </group>

                <notebook>
                    <!-- Existing -->
                    <page string="Cut Lines">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="length"/>
                                <field name="quantity"/>
                            </list>
                        </field>
                    </page>

                    <!-- NEW PAGE 1 -->
                    <page string="Availability">
                        <field name="availability_ids">
                            <list create="0" edit="0" delete="0">
                                <field name="product_id"/>
                                <field name="required_qty"/>
                                <field name="available_qty"/>
                                <field name="is_available"/>
                            </list>
                        </field>
                    </page>

                    <!-- NEW PAGE 2 -->
                    <page string="Cut Details">
                        <field name="cut_result_ids">
                            <list create="0" edit="0" delete="0">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="source_product_id"/>
                            </list>
                        </field>
                    </page>

                </notebook>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_dynamic_product_cut" model="ir.actions.act_window">
        <field name="name">Dynamic Product Cut</field>
        <field name="res_model">dynamic.product.cut</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- MENUS -->
    <menuitem
            id="menu_dynamic_product_cut_root"
            name="Dynamic Cutting"/>

    <menuitem
            id="menu_dynamic_product_cut"
            name="Cut Process"
            parent="menu_dynamic_product_cut_root"
            action="action_dynamic_product_cut"/>

</odoo>