<odoo>

    <!-- LIST VIEW -->
    <record id="view_dynamic_product_cut_list" model="ir.ui.view">
        <field name="name">dynamic.product.cut.list</field>
        <field name="model">dynamic.product.cut</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="wood_template_id"/>
                <field name="total_logs_used" optional="hide"/>
                <field name="total_length_required" string="Required (mtr)" optional="hide"/>
                <field name="total_waste" string="Waste (mtr)" optional="hide"/>
                <field name="efficiency_pct" string="Efficiency (%)" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_dynamic_product_cut_form" model="ir.ui.view">
        <field name="name">dynamic.product.cut.form</field>
        <field name="model">dynamic.product.cut</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process_cut"
                            type="object"
                            string="Process"
                            class="btn-primary"/>
                </header>

                <group>
                    <group>
                        <field name="wood_template_id"/>
                    </group>
                    <!-- Summary panel — optiCutter-style overview after processing -->
                    <group string="Cutting Summary">
                        <field name="total_logs_used" readonly="1"/>
                        <field name="total_length_required" readonly="1"/>
                        <field name="total_length_sourced" readonly="1"/>
                        <field name="total_waste" readonly="1"/>
                        <field name="efficiency_pct" readonly="1" string="Efficiency (%)"/>
                    </group>
                </group>

                <notebook>
                    <!-- Cut Lines -->
                    <page string="Cut Lines">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="length"/>
                                <field name="quantity"/>
                            </list>
                        </field>
                    </page>

                    <!-- Availability -->
                    <page string="Availability">
                        <field name="availability_ids">
                            <list create="0" edit="0" delete="0"
                                  decoration-success="is_available == True"
                                  decoration-danger="is_available == False">
                                <!--
                                    Show expected_code as the primary label.
                                    When the product already exists in stock,
                                    product_id will match; when it doesn't exist
                                    yet, expected_code is the only identifier.
                                -->
                                <field name="expected_code" string="Product Code"/>
                                <field name="product_id" string="Product (if exists)" optional="show"/>
                                <field name="length" string="Length (mtr)"/>
                                <field name="required_qty" string="Required"/>
                                <field name="available_qty" string="Available"/>
                                <field name="is_available" string="✓ Available"/>
                            </list>
                        </field>
                    </page>

                    <!-- Cut Details — grouped by source log with length subtotals -->
                    <page string="Cut Details">
                        <field name="cut_result_ids">
                            <list create="0" edit="0" delete="0"
                                  default_group_by="source_product_id"
                                  decoration-muted="is_offcut == True">
                                <field name="source_product_id" string="Source Log"/>
                                <field name="product_id" string="Cut Piece"/>
                                <field name="length_cut" string="Length (mtr)" sum="Total (mtr)"/>
                                <field name="quantity" sum="Pieces"/>
                                <field name="is_offcut" string="Offcut"/>
                            </list>
                        </field>
                    </page>

                </notebook>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_dynamic_product_cut" model="ir.actions.act_window">
        <field name="name">Dynamic Product Cut</field>
        <field name="res_model">dynamic.product.cut</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS -->
    <menuitem
            id="menu_dynamic_product_cut_root"
            name="Dynamic Cutting"/>

    <menuitem
            id="menu_dynamic_product_cut"
            name="Cut Process"
            parent="menu_dynamic_product_cut_root"
            action="action_dynamic_product_cut"/>

</odoo>