<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list View -->
    <record id="view_aretx_sms_cron_log_list" model="ir.ui.view">
        <field name="name">aretx.sms.cron.log.list</field>
        <field name="model">aretx.sms.cron.log</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="phone"/>
                <field name="template_id"/>
                <field name="delivery_status"/>
                <field name="msg_id"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_aretx_sms_cron_log_form" model="ir.ui.view">
        <field name="name">aretx.sms.cron.log.form</field>
        <field name="model">aretx.sms.cron.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="create_date" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="vehicle_id" readonly="1"/>
                        <field name="phone" readonly="1"/>
                        <field name="template_id" readonly="1"/>
                        <field name="delivery_status" readonly="1"/>
                        <field name="msg_id" readonly="1"/>
                        <field name="error_message" readonly="1"/>
                        <field name="message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_aretx_sms_cron_log" model="ir.actions.act_window">
        <field name="name">SMS Cron Logs</field>
        <field name="res_model">aretx.sms.cron.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_aretx_sms_cron_log"
          name="SMS Cron Logs"
          parent="parent_menu_sms_template"
          action="action_aretx_sms_cron_log"
          sequence="30"/>




</odoo>
