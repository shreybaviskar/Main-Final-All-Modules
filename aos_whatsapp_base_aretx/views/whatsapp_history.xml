<odoo>
    <record model="ir.ui.view" id="whatsapp_history_form_view">
        <field name="name">whatsapp.history.form</field>
        <field name="model">whatsapp.history</field>
        <field name="arch" type="xml">
            <form string="WhatsApp History">
                <header>
                    <field name="type" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="provider_id"/>
                        <field name="company_id"/>
                        <field name="model"/>
                        <field name="date"/>
                        <field name="author_id"/>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="message"/>
                        <field name="message_id"/>
                        <field name="mail_message_id"/>
                        <field name="rec_id"/>
                        <field name="fail_reason"/>
                        <field name="active" invisible="1"/>
                        <field name="allowed_company_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record model="ir.ui.view" id="whatsapp_history_tree_view">
        <field name="name">whatsapp.history.tree</field>
        <field name="model">whatsapp.history</field>
        <field name="arch" type="xml">
            <list string="WhatsApp History" default_order="create_date desc">
                <field name="provider_id"/>
                <field name="date"/>
                <field name="author_id"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="message"/>
<!--                <field name="model"/>-->
                <field name="type"/>
<!--                <field name="active" invisible="1"/>-->
<!--                <field name="allowed_company_ids" invisible="1"/>-->
            </list>
        </field>
    </record>

