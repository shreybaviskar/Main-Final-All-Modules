<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="service_combo_tracker_form_view" model="ir.ui.view">
        <field name="name">service.combo.tracker.form</field>
        <field name="model">service.combo.tracker</field>
        <field name="arch" type="xml">
            <form create="0" edit="1" delete="0">
                <div class="row mb4">
                    <div class="col-6">
                        <group>
                            <!-- Active fields -->
                            <field name="state"/>
                            <field name="completed_date"/>
                            <field name="description"/>
                            <field name="is_infinite"/>

                            <!-- Commented inactive fields -->
                            <!--
                            <field name="service_combo_id"/>
                            <field name="service_id"/>
                            -->
                        </group>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="service_combo_tracker_tree_view" model="ir.ui.view">
        <field name="name">service.combo.tracker.tree</field>
        <field name="model">service.combo.tracker</field>
        <field name="arch" type="xml">
            <tree>
                <!-- Hidden vehicle fields for conditional display -->
                <field name="vehicle" column_invisible="1"/>
                <field name="vehicle_sale_order" column_invisible="1"/>
                <field name="vehicle_invoice" column_invisible="1"/>

                <!-- Main visible fields -->
                <field name="service_combo_id"/>
                <field name="service_id"/>
                <field name="state"/>

                <!-- Conditional vehicle display -->
                <field name="vehicle" column_invisible="vehicle_sale_order or vehicle_invoice"/>
                <field name="vehicle_sale_order" column_invisible="vehicle or vehicle_invoice"/>
                <field name="vehicle_invoice" column_invisible="vehicle or vehicle_sale_order"/>

                <!-- Additional fields -->
                <field name="is_infinite"/>
                <field name="expiry_date"/>
                <field name="completed_date"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_combo_tracker" model="ir.actions.act_window">
        <field name="name">Combo Service Tracker</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">service.combo.tracker</field>
        <field name="view_mode">tree</field>
        <field name="context">{'group_by':['expiry_date', 'service_combo_id','service_id']}</field>
    </record>

    <!-- Menu Items - Commented as per requirement -->
    <!--
    <menuitem id="menu_Service_root" name="Combo Services" parent="aretx_job_card.menu_job_card_root" sequence="60"/>
    <menuitem id="menu_service_tracker" name="Combo Service Tracker" action="action_combo_tracker" parent="menu_Service_root" sequence="0"/>
    -->
</odoo>