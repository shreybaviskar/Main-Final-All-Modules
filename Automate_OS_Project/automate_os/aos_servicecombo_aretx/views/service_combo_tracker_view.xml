<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View - UPDATED FOR ODOO 19 -->
    <record id="service_combo_tracker_tree_view" model="ir.ui.view">
        <field name="name">service.combo.tracker.tree</field>
        <field name="model">service.combo.tracker</field>
        <field name="arch" type="xml">
            <list>
                <!-- Hidden vehicle display fields for conditional logic -->
                <field name="vehicle_sale_order_display" column_invisible="1"/>
                <field name="vehicle_invoice_display" column_invisible="1"/>

                <!-- Main fields -->
                <field name="service_combo_id"/>
                <field name="service_id"/>
                <field name="state"/>

                <!-- Conditional vehicle number display -->
                <field name="vehicle_sale_order_display"
                       string="Vehicle Number"
                       column_invisible="vehicle_invoice_display"/>
                <field name="vehicle_invoice_display"
                       string="Vehicle Number"
                       column_invisible="vehicle_sale_order_display"/>

                <!-- Additional fields -->
                <field name="is_infinite"/>
                <field name="expiry_date"/>
                <field name="completed_date"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="service_combo_tracker_form_view" model="ir.ui.view">
        <field name="name">service.combo.tracker.form</field>
        <field name="model">service.combo.tracker</field>
        <field name="arch" type="xml">
            <form create="0" edit="1" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="service_combo_id" readonly="1"/>
                            <field name="service_id" readonly="1"/>
                            <field name="state"/>
                            <field name="expiry_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="completed_date"/>
                            <field name="description"/>
                            <field name="is_infinite" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_combo_tracker" model="ir.actions.act_window">
        <field name="name">Combo Service Tracker</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">service.combo.tracker</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'group_by':['expiry_date', 'service_combo_id','service_id']}</field>
    </record>

    <!-- Menu Items -->
    <!--
    <menuitem id="menu_Service_root"
              name="Combo Services"
              parent="aretx_job_card.menu_job_card_root"
              sequence="60"/>
    <menuitem id="menu_service_tracker"
              name="Combo Service Tracker"
              action="action_combo_tracker"
              parent="menu_Service_root"
              sequence="0"/>
    -->
</odoo>