<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="report_pdf_options.ButtonOptions" owl="1">
        <Dialog size="'sm'" title="title">
            <div class="text-center">
                <div class="btn-group">
                    <button class="btn btn-info"
                            t-on-click="() => this.executePdfAction('print')">
                        <i class="fa fa-print me-2"/> Print
                    </button>
                    <button class="btn btn-info"
                            t-on-click="() => this.executePdfAction('download')">
                        <i class="fa fa-download me-2"/> Download
                    </button>
                    <button class="btn btn-info"
                            t-on-click="() => this.executePdfAction('open')">
                        <i class="fa fa-file-text me-2"/> Open
                    </button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
