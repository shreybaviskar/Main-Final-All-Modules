<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Storage Limit Exceeded Form View -->
    <record id="view_storage_limit_exceeded_form" model="ir.ui.view">
        <field name="name">storage.limit.exceeded.form</field>
        <field name="model">database.monitor</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form string="Storage Limit Exceeded" create="0" edit="0" delete="0">
                <header>
                    <button name="action_get_more_storage"
                            string="🛒 Upgrade Storage Plan"
                            type="object"
                            class="oe_highlight"/>
                </header>
                <sheet>

                    <!-- Top Alert Banner -->
                    <div class="alert alert-danger" role="alert" style="margin-bottom: 30px; text-align: center;">
                        <h1 style="margin: 0 0 10px 0; font-size: 60px;">🗄️</h1>
                        <h2 style="margin: 0 0 10px 0; color: #721c24;">Storage Limit Exceeded</h2>
                        <h3 style="margin: 0; color: #721c24;">⚠️ 100% Storage Used - All Operations Blocked</h3>
                    </div>

                    <group>
                        <group string="Storage Information">
                            <field name="name" readonly="1"/>
                            <field name="db_storage_mb" readonly="1"/>
                            <field name="file_storage_mb" readonly="1"/>
                            <field name="used_storage_mb" readonly="1"
                                   decoration-danger="storage_percent &gt;= 100"/>
                            <field name="space_allocation" readonly="1"/>
                            <field name="storage_percent" widget="progressbar" readonly="1"/>
                            <field name="storage_usage_text" readonly="1"/>
                        </group>

                        <group string="System Status">
                            <field name="show_storage_warning" invisible="1"/>
                            <div colspan="2" class="alert alert-warning" style="margin: 10px 0;">
                                <h4 style="margin-top: 0; color: #856404;">
                                    🚫 Operations Blocked
                                </h4>
                                <p style="color: #856404; margin: 5px 0;">
                                    The following operations are currently disabled:
                                </p>
                                <ul style="color: #856404; margin: 10px 0;">
                                    <li>Creating new records</li>
                                    <li>Uploading files</li>
                                    <li>Updating existing data</li>
                                    <li>Processing transactions</li>
                                    <li>Generating reports</li>
                                </ul>
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="What Happened?" name="explanation">
                            <group>
                                <div class="alert alert-info">
                                    <h4>Why is my access blocked?</h4>
                                    <p>
                                        Your database has consumed all allocated storage space.
                                        To protect your data integrity and prevent system errors,
                                        Odoo has automatically blocked all write operations.
                                    </p>
                                    <p>
                                        This is a normal safety measure and your data remains safe.
                                    </p>
                                </div>
                            </group>
                        </page>

                        <page string="How to Fix?" name="solution">
                            <group>
                                <div class="alert alert-success">
                                    <h4>Steps to Restore Access:</h4>
                                    <ol style="margin: 10px 0; line-height: 2;">
                                        <li><strong>Contact Support:</strong> Email support@yourcompany.com immediately</li>
                                        <li><strong>Choose Plan:</strong> Select a storage plan that fits your needs</li>
                                        <li><strong>Upgrade:</strong> Complete the upgrade process</li>
                                        <li><strong>Instant Access:</strong> Your system will be unlocked automatically</li>
                                    </ol>
                                    <p style="margin-top: 20px;">
                                        <strong>Need immediate assistance?</strong><br/>
                                        Call: +1-XXX-XXX-XXXX<br/>
                                        Email: support@yourcompany.com
                                    </p>
                                </div>
                            </group>
                        </page>
                    </notebook>

                    <!-- Bottom Action Area -->
                    <div class="text-center" style="margin-top: 30px; padding: 20px; background-color: #f8f9fa; border-radius: 5px;">
                        <h3 style="margin-bottom: 15px;">Ready to Upgrade?</h3>
                        <p style="margin-bottom: 20px;">
                            Access will be restored immediately after upgrading
                        </p>
                        <button name="action_get_more_storage"
                                string="🛒 View Upgrade Plans Now"
                                type="object"
                                class="btn-primary btn-lg"
                                style="padding: 12px 30px; font-size: 16px;"/>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

</odoo>