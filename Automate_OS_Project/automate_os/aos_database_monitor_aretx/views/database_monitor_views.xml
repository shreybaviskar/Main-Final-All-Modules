<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ================= FORM VIEW ================= -->
        <record id="view_database_monitor_form" model="ir.ui.view">
            <field name="name">database.monitor.form</field>
            <field name="model">database.monitor</field>
            <field name="arch" type="xml">
                <form create="false" string="Database Monitor">

                    <sheet>
                        <field name="show_storage_warning" invisible="1"/>

                        <group>
                            <field name="name"/>

                        </group>

                        <group>
                            <group>
                                <field name="db_storage_mb"/>
                            </group>
                            <group>
                                <field name="file_storage_mb"/>
                                <field name="used_storage_mb" invisible="1"/>
                            </group>
                        </group>

                        <group>
                            <field name="space_allocation" invisible="1"/>
                            <field name="storage_usage_text" invisible="1"/>
                        </group>

                        <div class="o_storage_card">
                            <div class="o_storage_header">
                                <i class="fa fa-cloud o_storage_icon"/>
                                <span class="o_storage_title">Storage</span>
                            </div>

                            <field name="storage_percent"
                                   widget="progressbar"
                                   options="{'max_value': 100}"/>

                            <div class="o_storage_text">
                                <field name="storage_usage_text" readonly="1"/>
                            </div>
                        </div>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================= TREE VIEW ================= -->
        <record id="view_database_monitor_tree" model="ir.ui.view">
            <field name="name">database.monitor.tree</field>
            <field name="model">database.monitor</field>
            <field name="arch" type="xml">
                <list create="false">
                    <field name="name"/>
                    <field name="db_storage_mb"/>
                    <field name="file_storage_mb"/>
                </list>
            </field>
        </record>


        <!-- 🔥 ROOT MENU (MUST COME FIRST) -->
        <menuitem id="menu_database_monitor_root"
                  name="Database Monitor"
                  sequence="10"/>

        <!-- 🔥 SERVER ACTION -->
        <record id="action_database_monitor_server" model="ir.actions.server">
            <field name="name">Database Monitor</field>
            <field name="model_id" ref="model_database_monitor"/>
            <field name="state">code</field>
            <field name="code">
                action = env['database.monitor'].action_open_database_monitor()
            </field>
        </record>

        <!-- 🔥 CHILD MENU -->
        <menuitem id="menu_database_monitor"
                  name="Database Storage"
                  parent="menu_database_monitor_root"
                  action="action_database_monitor_server"/>

        <record id="res_config_settings_view_form_storage_allocation_mb" model="ir.ui.view">
            <field name="name">res.config.settings.storage.allocation.mb</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app string="Storage" name="storage_allocation">
                        <block title="Storage Allocation">
                            <setting>
                                <label for="space_allocation_mb" string="Allocated Storage Space (MB)"/>
                                <div class="text-muted">
                                    Set the logical storage limit in MB (does not allocate actual disk space)
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="space_allocation_mb" class="oe_inline"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
