<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aos_roi_wizard_form" model="ir.ui.view">
        <field name="name">aos.roi.wizard.form</field>
        <field name="model">aos.roi.wizard</field>
        <field name="arch" type="xml">
            <form string="ROI Generator">
                <header>
                    <button name="action_generate_excel" type="object" string="Generate Excel" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="new_invoices_per_month"/>
                        <field name="avg_cost"/>
                        <field name="percentage_returning"/>
                    </group>
                    <group>
                        <field name="file" filename="filename" widget="binary" readonly="1" nolabel="1"/>
                    </group>
                    <footer>
                        <button string="Generate Excel" type="object" name="action_generate_excel" class="btn-primary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aos_roi_wizard" model="ir.actions.act_window">
        <field name="name">ROI Generator</field>
        <field name="res_model">aos.roi.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_aos_roi_wizard_form"/>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'edit', 'default_new_invoices_per_month': 60}</field>
    </record>


<!--    <menuitem id="menu_aos_roi_root" name="AOS ROI" sequence="1000"/>-->
<!--    <menuitem id="menu_aos_roi_generator" name="Generate ROI" parent="menu_aos_roi_root"-->
<!--              action="action_aos_roi_wizard"/>-->
    <!-- Generated files list -->
    <record id="view_aos_roi_file_tree" model="ir.ui.view">
        <field name="name">aos.roi.file.tree</field>
        <field name="model">aos.roi.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_aos_roi_file_form" model="ir.ui.view">
        <field name="name">aos.roi.file.form</field>
        <field name="model">aos.roi.file</field>
        <field name="arch" type="xml">
            <form string="ROI File">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="file" filename="name" widget="binary" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aos_roi_files" model="ir.actions.act_window">
        <field name="name">Generated ROI Files</field>
        <field name="res_model">aos.roi.file</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_aos_roi_file_tree"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_aos_roi_files" name="Generated Files" parent="menu_aos_roi_root" action="action_aos_roi_files"/>

    <!-- Add "Generate ROI" link to the website header next to "Contact us" -->
    <template id="aos_roi_add_header_link" inherit_id="website.layout">
        <xpath expr="//ul[contains(@class,'nav')]" position="inside">
            <li class="nav-item">
                <a class="btn btn-primary ml-2" href="/aos-roi/webpage"
                   style="background: linear-gradient(135deg,#6f3f5b,#8a5772);border:none;padding:6px 14px;display:none !important;">
                    Generate ROI
                </a>
            </li>
        </xpath>
    </template>
    <!-- Public website page template for ROI generator (styled like Contact Us) -->
    <template id="aos_roi_page_template" name="AOS ROI Page">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <style>
                /* ROI table styling */
                .aos-roi-table {
                table-layout: fixed;
                width: 100%;
                font-family: 'Roboto', Arial, sans-serif;
                font-size: 1rem;
                color: #333333;
                border-collapse: separate;
                border-spacing: 0;
                border: 1px solid #5C4A3D;
                border-radius: 8px 8px 0 0;
                overflow: hidden;
                background: #fff;
                }
                .aos-roi-table thead th {
                background: #1D1000 !important;
                color: #fff;
                font-weight: bold;
                font-size: 0.9rem;
                padding: 6px 8px;
                text-align: center;
                vertical-align: middle;
                white-space: normal;
                word-wrap: break-word;
                overflow-wrap: break-word;
                border: 1px solid #5C4A3D;
                border-top: none;
                }
                .aos-roi-table thead th:first-child { border-left: none; }
                .aos-roi-info-icon { font-size: 0.85em; opacity: 1; cursor: help; margin-left: 4px; font-weight: bold; }
                .aos-roi-table thead tr:first-child th:first-child { border-top-left-radius: 8px; }
                .aos-roi-table thead tr:first-child th:last-child { border-top-right-radius: 8px; }
                .aos-roi-table tbody td {
                padding: 6px 8px;
                vertical-align: middle;
                border: 1px solid #5C4A3D;
                background: #fff;
                }
                .aos-roi-table tbody tr:nth-child(even) td { background: #fff; }
                .aos-roi-table tbody td:nth-child(5) { background: #F0F0EF; }
                .aos-roi-table tbody tr:nth-child(even) td:nth-child(5) { background: #F0F0EF; }
                .aos-roi-table tbody td:first-child {
                text-align: left;
                font-weight: normal;
                }
                .aos-roi-table td:nth-child(n+2) {
                white-space: nowrap;
                text-align: right;
                }
                .aos-roi-table th:nth-child(1) { min-width: 70px; }
                .aos-roi-table th:nth-child(2) { min-width: 220px; width: 20%; }
                .aos-roi-table th:nth-child(3) { min-width: 400px; }
                .aos-roi-table th:nth-child(4) { min-width: 140px; width: 16%; }
                .aos-roi-table th:nth-child(5) { min-width: 310px; }
                @media (max-width: 768px) {
                .aos-roi-info-icon { cursor: pointer; }
                .aos-roi-table { table-layout: fixed; width: 100%; font-size: 0.875rem; margin-bottom: 4px; }
                .aos-roi-table thead th { font-size: 0.8rem; padding: 4px 6px; }
                .aos-roi-table tbody td { font-size: 0.875rem; padding: 4px 6px; }
                .aos-roi-table th:nth-child(1), .aos-roi-table td:nth-child(1) { min-width: 0; width: 12%; }
                .aos-roi-table th:nth-child(2), .aos-roi-table td:nth-child(2) { min-width: 0; width: 18%; }
                .aos-roi-table th:nth-child(3), .aos-roi-table td:nth-child(3) { min-width: 0; width: 18%; }
                .aos-roi-table th:nth-child(4), .aos-roi-table td:nth-child(4) { min-width: 0; width: 15%; }
                .aos-roi-table th:nth-child(5), .aos-roi-table td:nth-child(5) { min-width: 0; width: 37%; }
                .aos-roi-summary-table { table-layout: fixed; width: 100%; max-width: 100%; margin-top: 4px; }
                .aos-roi-summary-table thead th { padding: 4px 6px; }
                .aos-roi-summary-table tbody td { padding: 4px 6px; }
                .aos-roi-summary-table th:nth-child(1), .aos-roi-summary-table td:nth-child(1) { min-width: 0; width:
                20%; }
                .aos-roi-summary-table th:nth-child(2), .aos-roi-summary-table td:nth-child(2) { min-width: 0; width:
                22%; }
                .aos-roi-summary-table th:nth-child(3), .aos-roi-summary-table td:nth-child(3) { min-width: 0; width:
                36%; }
                .aos-roi-summary-table th:nth-child(4), .aos-roi-summary-table td:nth-child(4) { min-width: 0; width:
                22%; }
                .row .col-md-6[style*="margin-top:368px"] { margin-top: 0 !important; }
                }
                .aos-roi-summary-table {
                width: 100%;
                table-layout: fixed;
                font-family: 'Roboto', Arial, sans-serif;
                }
                .aos-roi-summary-table th:nth-child(2), .aos-roi-summary-table td:nth-child(2) { min-width: 100px;
                width: 18%; }
                .aos-roi-summary-table th:nth-child(4), .aos-roi-summary-table td:nth-child(4) { min-width: 100px;
                width: 19%; }
                .aos-roi-summary-table td:nth-child(n+2) { white-space: nowrap; text-align: right; }
                .aos-roi-summary-table tbody td:nth-child(2) { background: #F0F0EF !important; }
                .aos-roi-summary-table tbody td:nth-child(4) { background: #bcedc7 !important; }
            </style>
            <section class="s_website_contact o_portal_layout"
                     style="background: linear-gradient(90deg, rgba(247,249,250,1) 0%, rgba(255,255,255,1) 100%);">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <h1 class="mt32 mb16" style="font-weight:700;letter-spacing:-0.5px;">Calculate ROI of
                                AutomateOS
                            </h1>
                            <p class="text-muted" style="max-width:700px;">Quickly model 60 months of revenue from
                                returning customers. Adjust the inputs below and click <strong>Calculate ROI</strong> to
                                preview the results
                            </p>
                        </div>
                    </div>
                </div>
            </section>
            <div class="container mt24 mb24">
                <div class="row justify-content-center">
                    <div class="col-lg-12 col-md-12">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card shadow-sm border-0">
                                    <div class="card-body">
                                        <form id="aos_roi_main_form" action="/aos-roi/webpage" method="post"
                                              class="o_form_horizontal">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="form-group">
                                                <label class="font-weight-semibold">No of Invoices per month</label>
                                                <input type="number" name="new_invoices_per_month" class="form-control"
                                                       t-att-value="new_invoices_per_month"/>
                                            </div>
                                            <div class="form-group">
                                                <label class="font-weight-semibold">Avg Cost of Alignment and
                                                    Balancing
                                                </label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text">₹</span>
                                                    </div>
                                                    <input type="number" step="0.01" name="avg_cost"
                                                           class="form-control" t-att-value="avg_cost"/>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="font-weight-semibold">Percentage of Returning Customers
                                                </label>
                                                <div class="input-group">
                                                    <input type="number" step="0.01" name="percentage_returning"
                                                           class="form-control" t-att-value="percentage_returning"/>
                                                    <div class="input-group-append">
                                                        <span class="input-group-text">%</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="font-weight-semibold">First year cost of software</label>
                                                <input type="number" name="first_year_cost" class="form-control"
                                                       placeholder="First year cost" t-att-value="first_year_cost"/>
                                            </div>
                                            <div class="form-group">
                                                <label class="font-weight-semibold">Annual cost of software</label>
                                                <input type="number" name="annual_cost" class="form-control"
                                                       placeholder="Annual cost" t-att-value="annual_cost"/>
                                            </div>
                                            <div class="form-group text-left mt-4">
                                                <button type="submit" class="btn btn-primary btn-sm"
                                                        style="background:#E78200;border:none;padding:8px 20px;font-size:15px;color:#000000;">
                                                    Calculate ROI
                                                </button>
                                            </div>
                                        </form>

                                        <!-- Monthly sheet displayed under the left inputs -->
                                        <t t-if="table_html">
                                            <div class="mt-3">
                                                <div class="table-responsive">
                                                    <t t-raw="table_html"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" style="margin-top:368px;">
                                <div class="card shadow-sm border-0">
                                    <div class="card-body">
                                        <!-- Summary table displayed under summary inputs -->
                                        <t t-if="summary_html">
                                            <div class="mt-3">
                                                <div class="table-responsive">
                                                    <t t-raw="summary_html"/>
                                                </div>
                                            </div>
                                        </t>

                                        <!-- Fallback iframe if file_url present -->
                                        <t t-if="file_url">
                                            <div class="mt-3">
                                                <div class="table-responsive">
                                                    <iframe t-att-src="file_url"
                                                            style="width:100%;height:600px;border:1px solid #eee;border-radius:4px;"></iframe>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- (generated content is shown in the right column of the main card) -->
                        <!-- Fallback to iframe if file_url is present (keeps previous behavior) -->
                        <t t-if="file_url">
                            <div class="card mt-4 shadow-sm">
                                <div class="card-body">
                                    <iframe t-att-src="file_url"
                                            style="width:100%;height:600px;border:1px solid #eee;border-radius:4px;"></iframe>
                                </div>
                            </div>
                        </t>
                        <!-- Summary table is displayed in the right column; no duplicate here -->
                    </div>
                </div>
            </div>
            <script>
                //<![CDATA[
        (function () {
          function toggleInlineTooltip(icon, text) {
            var existing = icon._aosInlineTooltip;
            if (existing && existing.parentNode) {
              existing.parentNode.removeChild(existing);
              icon._aosInlineTooltip = null;
              return;
            }
            var tooltip = document.createElement('div');
            tooltip.className = 'aos-roi-inline-tooltip';
            tooltip.textContent = text;
            tooltip.style.position = 'absolute';
            tooltip.style.background = '#ffffff';
            tooltip.style.color = '#000000';
            tooltip.style.border = '1px solid #5C4A3D';
            tooltip.style.padding = '4px 8px';
            tooltip.style.borderRadius = '4px';
            tooltip.style.fontSize = '0.8rem';
            tooltip.style.maxWidth = '260px';
            tooltip.style.zIndex = '9999';
            document.body.appendChild(tooltip);
            var rect = icon.getBoundingClientRect();
            tooltip.style.top = (window.scrollY + rect.bottom + 4) + 'px';
            tooltip.style.left = (window.scrollX + rect.left) + 'px';
            icon._aosInlineTooltip = tooltip;
            function onDocClick(ev) {
              if (icon.contains(ev.target) || tooltip.contains(ev.target)) {
                return;
              }
              if (tooltip && tooltip.parentNode) {
                tooltip.parentNode.removeChild(tooltip);
              }
              icon._aosInlineTooltip = null;
              document.removeEventListener('click', onDocClick);
            }
            document.addEventListener('click', onDocClick);
          }
          var icons = document.querySelectorAll('.aos-roi-info-icon');
          for (var i = 0; i < icons.length; i++) {
            (function (icon) {
              var text = icon.getAttribute('title');
              if (!text) {
                return;
              }
              icon.setAttribute('data-title', text);
              icon.setAttribute('role', 'button');
              icon.setAttribute('tabindex', '0');
              icon.addEventListener('click', function (ev) {
                ev.preventDefault();
                ev.stopPropagation();
                toggleInlineTooltip(icon, text);
              });
              icon.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter' || ev.key === ' ') {
                  ev.preventDefault();
                  toggleInlineTooltip(icon, text);
                }
              });
            })(icons[i]);
          }
        })();
        //]]>
            </script>
        </t>
    </template>
</odoo>
