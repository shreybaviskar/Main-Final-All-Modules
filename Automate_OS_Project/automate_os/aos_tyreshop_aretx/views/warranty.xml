<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        
        <record id="view_move_form_inherit_warranty" model="ir.ui.view">
            <field name="name">account.move.form.inherit.warranty</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="warranty_number" placeholder="SSDSDSD"
                           invisible="move_type not in ('out_invoice','out_refund')"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_list_inherit_warranty" model="ir.ui.view">
            <field name="name">account.move.list.inherit.warranty</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="warranty_number" optional="hide"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>