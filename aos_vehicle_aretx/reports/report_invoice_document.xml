<odoo>

    <template
            id="report_invoice_document_inherit"
            inherit_id="account.report_invoice_document">

        <xpath expr="//div[hasclass('row')]/t[1]/div[2]/t/address[@t-field='o.partner_id']" position="replace">
            <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'/>
            <span t-field="o.vehicle_number.x_vehicle_number_id"/>
            <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
            <span t-field="o.vehicle_kms"/>
        </xpath>
        <xpath expr="//div[hasclass('row')]/t[2]/div/t/address[@t-field='o.partner_id']" position="replace">
            <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'/>
            <span t-field="o.vehicle_number.x_vehicle_number_id"/>
            <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
            <span t-field="o.vehicle_kms"/>
        </xpath>
        <xpath expr="//div[hasclass('row')]/t[3]/div/t/address[@t-field='o.partner_id']" position="replace">
            <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'/>
            <span t-field="o.vehicle_number.x_vehicle_number_id"/>
            <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
            <span t-field="o.vehicle_kms"/>
        </xpath>

    </template>

</odoo>
